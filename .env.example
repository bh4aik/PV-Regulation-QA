# DeepSeek API Key（也可在网页「设置」页填写，优先使用网页设置）
DEEPSEEK_API_KEY=

# 模型（V4 系列；deepseek-chat/deepseek-reasoner 旧别名已于 2026-07 停用）
DEEPSEEK_MODEL=deepseek-v4-flash

# 端口
PORT=3000

# 反向代理层数；Docker Compose + 宿主机 Caddy 使用 1，本地直连保持 0
TRUST_PROXY_HOPS=0

# ---- 公网部署（VPS/Docker）必配 ----
# 预置管理员（系统无用户时首次启动自动创建）
ADMIN_USERNAME=izturn
ADMIN_PASSWORD=请设置强密码

# 关闭"首个注册用户自动成为管理员"（公网必须 false，防止抢注接管系统；本地开发可留默认 true）
AUTO_FIRST_ADMIN=false

# 普通用户每日 AI 问答限额（也可在网页设置页调整）
# DAILY_QA_LIMIT=20
